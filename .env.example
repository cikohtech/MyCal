# Copy to .env.local and fill in from your Supabase project's API settings.
#
# Leave these unset and My Cal runs fully on-device: every screen works, data
# stays in this browser, and barcode lookup goes straight to Open Food Facts.
#
# The anon key is meant to ship in the bundle — row level security is what
# protects the data, which is why the migration is the security boundary.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Sign-in has no other client-side settings. In the Supabase dashboard, under
# Authentication -> Providers, turn "Confirm email" off so creating an account
# signs you straight in, and fill in Google with a Google Cloud OAuth client
# whose redirect URI is https://YOUR-PROJECT.supabase.co/auth/v1/callback.
# Then add your deployed origin under Authentication -> URL Configuration.

# The AI key is NOT here and must never be. It lives only as a function secret,
# so it is never bundled into the client. Set the one for the provider you use:
#
#   supabase secrets set OPENAI_API_KEY=sk-...          # OpenAI
#   supabase secrets set ANTHROPIC_API_KEY=sk-ant-...   # Claude
#
# Whichever key is present decides the provider, so switching is a secret
# change rather than a code change.
#
# Optional function secrets:
#   AI_PROVIDER       openai | anthropic — only needed if both keys are set
#                     (without it, ANTHROPIC_API_KEY wins)
#   OPENAI_MODEL      overrides the default gpt-5.5 (gpt-5.4, gpt-5.4-mini
#                     are cheaper and a little faster)
#   ANTHROPIC_MODEL   overrides the default claude-opus-5
#   ALLOWED_ORIGIN    locks CORS to your deployed origin instead of *
