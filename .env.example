# Copy to .env.local and fill in from your Supabase project's API settings.
#
# Leave these unset and My Cal runs fully on-device: every screen works, data
# stays in this browser, and barcode lookup goes straight to Open Food Facts.
#
# The anon key is meant to ship in the bundle — row level security is what
# protects the data, which is why the migration is the security boundary.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Where this deployment lives, used for the links Supabase mails out. Leave it
# unset and the app uses whatever origin it is being served from, which is
# right almost always. Set it when a preview deployment should send people back
# to the production origin instead of to itself.
#
#   VITE_SITE_URL=https://your-app.vercel.app
#
# In the Supabase dashboard, Authentication -> URL Configuration needs the same
# origin as Site URL, plus https://your-app.vercel.app/auth/confirm in the
# redirect list. A Site URL left on localhost is how a live app mails its users
# a confirmation link to somebody's laptop.

# Sign-in has no other client-side settings. In the dashboard, under
# Authentication -> Providers, Google takes the client ID and secret from a
# Google Cloud OAuth client whose redirect URI is
# https://YOUR-PROJECT.supabase.co/auth/v1/callback. "Confirm email" can be on
# or off: on, sign-up shows an inbox step and the link lands on /auth/confirm;
# off, sign-up hands back a session and goes straight to setup.
#
# Authentication -> Emails -> Templates takes the five files in
# supabase/templates/ — the hosted project does not read supabase/config.toml.

# The AI key is NOT here and must never be. It lives only as a function secret,
# so it is never bundled into the client. Set the one for the provider you use:
#
#   supabase secrets set OPENAI_API_KEY=sk-...          # OpenAI
#   supabase secrets set ANTHROPIC_API_KEY=sk-ant-...   # Claude
#
# Whichever key is present decides the provider, so switching is a secret
# change rather than a code change.
#
# Optional function secrets:
#   AI_PROVIDER       openai | anthropic — only needed if both keys are set
#                     (without it, ANTHROPIC_API_KEY wins)
#   OPENAI_MODEL      overrides the default gpt-5.5 (gpt-5.4, gpt-5.4-mini
#                     are cheaper and a little faster)
#   ANTHROPIC_MODEL   overrides the default claude-opus-5
#   ALLOWED_ORIGIN    locks CORS to your deployed origin instead of *
#
# Rate limiting — every request spends against the account AND the calling
# address, and both have to pass. Defaults in brackets:
#   ANALYZE_USER_PER_MINUTE [8]   ANALYZE_IP_PER_MINUTE [15]
#   ANALYZE_USER_PER_HOUR   [40]  ANALYZE_IP_PER_HOUR   [80]
#   ANALYZE_USER_PER_DAY    [120] ANALYZE_IP_PER_DAY    [300]
#   BARCODE_USER_PER_MINUTE [30]  BARCODE_IP_PER_MINUTE [60]
#   BARCODE_USER_PER_HOUR   [300] BARCODE_IP_PER_HOUR   [600]
#   RATE_LIMIT_SALT         addresses are hashed before they are stored; this
#                           is the salt. Defaults to the service role key.
